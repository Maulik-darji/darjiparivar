<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Flat theme: solid colours, no gradients, soft rounded corners. -->
    <style name="Base.Theme.DarjiParivar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="colorSecondaryContainer">@color/primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorOutline">@color/ink</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.Rounded</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Rounded</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Rounded</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Rounded</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Rounded</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Rounded</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Rounded</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Rounded</item>

        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>
        <item name="textInputStyle">@style/Widget.App.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="tabStyle">@style/Widget.App.Tabs</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.App.Progress</item>
    </style>

    <style name="Theme.DarjiParivar" parent="Base.Theme.DarjiParivar" />

    <style name="ShapeAppearance.App.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Rounded</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Rounded</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
        <item name="strokeColor">@color/ink</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">14dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Rounded</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Rounded</item>
        <item name="boxStrokeColor">@color/ink</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/ink</item>
    </style>

    <style name="Widget.App.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/ink</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/ink</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Rounded</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.App.Tabs" parent="Widget.Material3.TabLayout">
        <item name="tabIndicator">@drawable/tab_indicator</item>
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabSelectedTextColor">@color/ink</item>
        <item name="tabTextColor">@color/ink_muted</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.Tab</item>
        <item name="tabRippleColor">@color/line</item>
        <item name="android:background">@color/bg</item>
    </style>

    <style name="Widget.App.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackCornerRadius">3dp</item>
        <item name="trackThickness">6dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="indicatorColor">@color/primary</item>
        <item name="trackColor">@color/line</item>
    </style>

    <style name="TextAppearance.App.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Typography -->
    <style name="Text.Display" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Muted" parent="">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Tag" parent="">
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
