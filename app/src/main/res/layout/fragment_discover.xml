<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_discover" />
        </LinearLayout>

        <TextView
            android:id="@+id/count"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_tag"
            android:backgroundTint="@color/primary_soft"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/primary" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/chip_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_all" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_verified" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_verified" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_online" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_online" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_premium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_premium" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_nri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_abroad" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/offline"
        style="@style/Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_tag"
        android:backgroundTint="@color/primary_soft"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/offline_banner"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Card deck: the back card peeks out behind the front one. -->
    <FrameLayout
        android:id="@+id/deck"
        android:layout_width="match_parent"
        android:clipChildren="false"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:layout_weight="1">

        <include
            android:id="@+id/card_back"
            layout="@layout/item_swipe_card" />

        <include
            android:id="@+id/card_front"
            layout="@layout/item_swipe_card" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/primary_soft"
                android:contentDescription="@null"
                android:padding="20dp"
                android:src="@drawable/ic_heart"
                app:tint="@color/primary" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/caught_up_title" />

            <TextView
                style="@style/Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/caught_up_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_restart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/start_over" />
        </LinearLayout>

        <include
            android:id="@+id/state"
            layout="@layout/view_state" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btn_pass"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_outline"
            android:contentDescription="@string/pass"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/btn_shortlist"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/bg_circle_outline"
            android:contentDescription="@string/shortlist"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star"
            app:tint="@color/gold" />

        <ImageButton
            android:id="@+id/btn_like"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/primary"
            android:contentDescription="@string/send_interest"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart"
            app:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
